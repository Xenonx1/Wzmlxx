# ---------- required ----------
BOT_TOKEN=123456:ABC...            # from @BotFather
OWNER_ID=123456789                 # your Telegram user id
TELEGRAM_API=1234567               # from my.telegram.org
TELEGRAM_HASH=abcdef0123456789
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
BASE_URL=https://your-service.onrender.com   # public URL; also used as keep-alive ping + file selection page

# ---------- optional / useful ----------
USER_SESSION_STRING=               # premium account session string (4 GB leech, hybrid leech)
AUTHORIZED_CHATS=                  # "-100123 -100456|topic_id"
SUDO_USERS=                        # "111 222"
LEECH_DUMP_CHAT=                   # chat/channel id (or -100id|topic) to also dump leeched files
LEECH_SPLIT_SIZE=0                 # 0 = auto (2 GB, or 4 GB with premium session)
AS_DOCUMENT=false                  # send as document instead of media
MEDIA_GROUP=false
LEECH_PREFIX=
LEECH_SUFFIX=
LEECH_CAPTION=
THUMBNAIL_LAYOUT=
EXCLUDED_EXTENSIONS=               # "mp3 txt nfo"
YT_DLP_OPTIONS={}
CMD_SUFFIX=
SET_COMMANDS=true
TIMEZONE=Asia/Kolkata
STATUS_LIMIT=10
STATUS_UPDATE_INTERVAL=15
BOT_MAX_TASKS=0
USER_MAX_TASKS=0
QUEUE_ALL=0
QUEUE_DOWNLOAD=0
QUEUE_UPLOAD=0
TORRENT_TIMEOUT=0
DISABLE_TORRENTS=false
DISABLE_SEED=true
DISABLE_BULK=false
DISABLE_MULTI=false
DELETE_LINKS=false
INCOMPLETE_TASK_NOTIFIER=true
WEB_PINCODE=true
LOGIN_PASS=
